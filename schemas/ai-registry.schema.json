{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ledgerlink.internal/qa/ai-registry.schema.json",
  "title": "AI tool, model and MCP server registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated", "tools", "agents", "mcp_servers"],
  "properties": {
    "version": { "const": 1 },
    "updated": { "$ref": "#/definitions/date" },
    "tools": { "type": "array", "items": { "$ref": "#/definitions/tool" } },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["login", "tool"],
        "properties": { "login": { "type": "string", "minLength": 1 }, "tool": { "$ref": "#/definitions/id" } }
      }
    },
    "mcp_servers": { "type": "array", "items": { "$ref": "#/definitions/mcpServer" } }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "enum": ["approved", "pending-inventory", "blocked", "retired"] },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "vendor", "status", "tier", "models", "owner", "review_by"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "minLength": 1 },
        "vendor": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/definitions/status" },
        "tier": { "type": "string" },
        "models": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "owner": { "type": "string" },
        "review_by": { "$ref": "#/definitions/date" },
        "trailer_aliases": { "type": "array", "items": { "type": "string", "minLength": 3 } },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mcp_config": { "type": "string" },
            "rule_file": { "type": "string" },
            "exclusion_file": { "type": "string" }
          }
        }
      }
    },
    "mcpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "owner", "match"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "status": { "$ref": "#/definitions/status" },
        "owner": { "type": "string" },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "package": { "type": "string", "minLength": 1 },
            "versions": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([-+].*)?$" }
            },
            "url": { "type": "string", "pattern": "^https://" },
            "command": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
