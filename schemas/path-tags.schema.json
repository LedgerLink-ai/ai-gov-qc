{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ledgerlink.internal/qa/path-tags.schema.json",
  "title": "Path tags",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tags"],
  "properties": {
    "version": { "const": 1 },
    "tags": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "owners", "min_approvals", "paths"],
        "properties": {
          "description": { "type": "string" },
          "owners": { "type": "array", "items": { "type": "string" } },
          "min_approvals": { "type": "integer", "minimum": 1, "maximum": 3 },
          "only_if_untagged": { "type": "boolean" },
          "paths": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}
