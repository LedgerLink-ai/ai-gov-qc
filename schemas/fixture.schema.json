{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ledgerlink.internal/qa/fixture.schema.json",
  "title": "Conformance fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "repo", "actor", "expect"],
  "properties": {
    "id": { "type": "string", "pattern": "^F\\d{2}[a-z]?$" },
    "title": { "type": "string", "minLength": 1 },
    "repo": { "type": "string", "minLength": 1 },
    "actor": { "enum": ["human", "agent", "ci"] },
    "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "requires": { "type": "array", "items": { "type": "string" } },
    "pending": { "type": "string", "description": "Reason the fixture cannot pass yet; it is reported, not run" },
    "commit_message": { "type": "string" },
    "pr_title": { "type": "string", "description": "Pull request title, for the pr-text checks" },
    "pr_body": { "type": "string", "description": "Pull request description, for the pr-text checks" },
    "baseline_from_self": { "type": "boolean" },
    "values": {
      "type": "object",
      "description": "Placeholders {{NAME}} in tree files. A list is joined; a codepoint is decoded. Keeps planted secrets and hidden characters out of this repository.",
      "additionalProperties": {
        "oneOf": [
          { "type": "array", "minItems": 1, "items": { "type": "string" } },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["codepoint"],
            "properties": { "codepoint": { "type": "string", "pattern": "^U\\+[0-9A-F]{4,6}$" } }
          }
        ]
      }
    },
    "exact": { "type": "boolean", "description": "No error-level findings other than those expected" },
    "expect": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "blocking"],
        "properties": {
          "check": { "type": "string" },
          "path": { "type": "string" },
          "blocking": { "type": "boolean" }
        }
      }
    }
  }
}
