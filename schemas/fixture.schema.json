{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ledgerlink.internal/qa/fixture.schema.json",
  "title": "Conformance fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "repo", "actor", "expect"],
  "definitions": {
    "path": { "type": "string", "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(^|/)\\.\\.(/|$)).+$" }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^F\\d{2}[a-z]?$" },
    "title": { "type": "string", "minLength": 1 },
    "repo": { "type": "string", "minLength": 1 },
    "actor": { "enum": ["human", "agent", "ci"] },
    "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "requires": { "type": "array", "items": { "type": "string" } },
    "pending": { "type": "string", "description": "Reason the fixture cannot pass yet; it is reported, not run" },
    "commit_message": { "type": "string" },
    "branch": {
      "type": "string",
      "description": "The branch being committed to, for the branch and commit message checks"
    },
    "baseline_from_self": { "type": "boolean" },
    "values": {
      "type": "object",
      "description": "Placeholders {{NAME}} in tree files. A list is joined; a codepoint is decoded; random is generated each time the fixture runs (length characters, or parts joined by dots, after an optional prefix). Keeps planted secrets and hidden characters out of this repository.",
      "additionalProperties": {
        "oneOf": [
          { "type": "array", "minItems": 1, "items": { "type": "string" } },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["codepoint"],
            "properties": { "codepoint": { "type": "string", "pattern": "^U\\+[0-9A-F]{4,6}$" } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["random"],
            "properties": {
              "random": { "enum": ["alnum", "hex", "base64url", "password"] },
              "length": { "type": "integer", "minimum": 4, "maximum": 4096 },
              "parts": {
                "type": "array",
                "minItems": 2,
                "items": { "type": "integer", "minimum": 0, "maximum": 4096 }
              },
              "prefix": { "type": "string", "maxLength": 64 }
            }
          }
        ]
      }
    },
    "exact": { "type": "boolean", "description": "No error-level findings other than those expected" },
    "operations": {
      "type": "array",
      "description": "File operations, committed on a branch over tree/ (committed on main); the fixture then runs from git, as qa check --base does",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["rename"],
            "properties": {
              "rename": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to"],
                "properties": { "from": { "$ref": "#/definitions/path" }, "to": { "$ref": "#/definitions/path" } }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["delete"],
            "properties": { "delete": { "$ref": "#/definitions/path" } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["write"],
            "properties": {
              "write": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path"],
                "properties": {
                  "path": { "$ref": "#/definitions/path" },
                  "lines": { "type": "integer", "minimum": 1 },
                  "text": { "type": "string" }
                }
              }
            }
          }
        ]
      }
    },
    "pr": {
      "type": "object",
      "description": "A pull request: the fixture runs from git as qa prepr does, with the pull request rules",
      "additionalProperties": false,
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "commits": {
          "type": "array",
          "minItems": 1,
          "description": "Oldest first; the first commit carries the operations",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["message"],
            "properties": { "message": { "type": "string", "minLength": 1 } }
          }
        },
        "coverage": {
          "type": "array",
          "description": "Coverage summaries the test run wrote (left uncommitted)",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "lines_pct"],
            "properties": {
              "file": { "$ref": "#/definitions/path" },
              "lines_pct": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          }
        }
      }
    },
    "expect": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "blocking"],
        "properties": {
          "check": { "type": "string" },
          "path": { "type": "string" },
          "blocking": { "type": "boolean" }
        }
      }
    }
  }
}
