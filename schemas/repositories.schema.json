{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ledgerlink.internal/qa/repositories.schema.json",
  "title": "Repositories permitted to run the QA engine",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "org", "repositories"],
  "properties": {
    "version": { "const": 1 },
    "org": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "enabled"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "enabled": { "type": "boolean" },
          "owner": { "type": "string", "minLength": 1 },
          "approved_by": { "type": "string", "minLength": 1 },
          "onboarded": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
