{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ledgerlink.internal/qa/checks.schema.json",
  "title": "Check registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "checks"],
  "properties": {
    "version": { "const": 1 },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "kind", "stage", "scope", "tags", "controls", "rules"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["native", "tool"] },
          "tool": { "type": "string", "minLength": 1 },
          "stage": { "enum": [0, 1, 2, 3] },
          "scope": { "enum": ["file", "commit", "pr", "release"] },
          "tags": {
            "oneOf": [{ "const": "all" }, { "type": "array", "minItems": 1, "items": { "type": "string" } }]
          },
          "extra_globs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "controls": { "type": "array", "items": { "type": "string", "pattern": "^C\\d{2}-\\d+$" } },
          "rules": { "type": "array", "items": { "type": "string", "pattern": "^R\\d{2}-\\d+$" } },
          "source": { "type": "string", "minLength": 1 }
        },
        "if": { "properties": { "kind": { "const": "tool" } } },
        "then": { "properties": { "tool": { "type": "string" } }, "required": ["tool"] }
      }
    }
  }
}
