{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ledgerlink.internal/qa/policy.schema.json",
  "title": "Policy: modes, switch-on dates and limits",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "defaults", "local", "protected", "checks"],
  "properties": {
    "version": { "const": 1 },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "$ref": "#/definitions/mode" } }
    },
    "local": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_budget_ms"],
      "properties": {
        "time_budget_ms": { "type": "integer", "minimum": 1000 },
        "prepush_time_budget_ms": { "type": "integer", "minimum": 1000 },
        "prepr_time_budget_ms": { "type": "integer", "minimum": 1000 }
      }
    },
    "pr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch_pattern", "diff_warn_lines", "diff_max_lines", "diff_ignore", "coverage_min_lines"],
      "properties": {
        "branch_pattern": { "type": "string", "minLength": 1 },
        "diff_warn_lines": { "type": "integer", "minimum": 1 },
        "diff_max_lines": { "type": "integer", "minimum": 1 },
        "diff_ignore": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "coverage_min_lines": { "type": "number", "minimum": 0, "maximum": 100 },
        "title_pattern": { "type": "string", "minLength": 1 },
        "title_example": { "type": "string", "minLength": 1 },
        "ticket_projects": { "$ref": "#/definitions/ticketProjects" },
        "ticket_url": { "$ref": "#/definitions/ticketUrl" },
        "description_sections": { "$ref": "#/definitions/prSections" },
        "repos": {
          "type": "object",
          "description": "Pull request conventions for single repositories, by repository name",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title_pattern": { "type": "string", "minLength": 1 },
              "title_example": { "type": "string", "minLength": 1 },
              "ticket_projects": { "$ref": "#/definitions/ticketProjects" },
              "ticket_url": { "$ref": "#/definitions/ticketUrl" },
              "description_sections": { "$ref": "#/definitions/prSections" }
            }
          }
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool_ms": { "type": "integer", "minimum": 1000 },
        "tools": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1000 } },
        "git_ms": { "type": "integer", "minimum": 1000 },
        "download_ms": { "type": "integer", "minimum": 1000 },
        "network_retries": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parallelism": { "type": "integer", "minimum": 1, "maximum": 64 },
        "cache": { "type": "boolean" }
      }
    },
    "min_engine_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "protected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tags", "globs"],
      "properties": {
        "tags": { "type": "array", "items": { "type": "string" } },
        "globs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode"],
        "properties": {
          "mode": { "$ref": "#/definitions/mode" },
          "block_from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  },
  "definitions": {
    "mode": { "enum": ["off", "report", "block"] },
    "ticketProjects": {
      "type": "array",
      "description": "Jira project keys a ticket reference may use; empty accepts any key",
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+$" }
    },
    "ticketUrl": { "type": "string", "pattern": "^https://[^ ]+/$" },
    "prSections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "checklist": { "type": "boolean" }
        }
      }
    }
  }
}
